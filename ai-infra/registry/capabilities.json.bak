{"schemaVersion":1,"description":"用户意图级能力注册表。AI 接任务后先 grep 匹配 intents，命中后走对应路由。","capabilities":[{"id":"cap.code-search","name":"代码搜索定位","intents":["找代码","搜索文件","定位函数","谁调用了","定义在哪","grep","glob"],"primary":"agent.explore","fallbacks":["builtin.Grep","builtin.Glob"],"requiredSkills":[]},{"id":"cap.code-small-fix","name":"小范围代码修改","intents":["修bug","改一行","修typo","小改动","fix","patch","改配置","修改","改","调整","修"],"primary":"builtin.Edit","fallbacks":["agent.code-simplifier"],"requiredSkills":["skill.systematic-debugging"],"requiredSteps":["read","edit","verify"]},{"id":"cap.code-feature","name":"功能开发/大改动","intents":["实现功能","新功能","重构","多文件","架构","接口","API","feature","bounty","悬赏","赏金","赚钱"],"primary":"agent.plan","fallbacks":["model.gpt55","agent.general-purpose"],"requiredSkills":["skill.brainstorming","skill.writing-plans"],"requiredSteps":["design","implement","review","verify"]},{"id":"cap.code-review","name":"代码审查","intents":["审查","review","检查代码","有没有问题","audit代码","self-review","自我审查","自查","自审"],"primary":"skill.code-review","fallbacks":["model.gpt55"],"requiredSkills":["skill.requesting-code-review"]},{"id":"cap.code-simplify","name":"代码简化重构","intents":["简化","refactor","优化代码","cleanup","整理代码"],"primary":"skill.simplify","fallbacks":["skill.code-review"],"requiredSkills":["skill.simplify"]},{"id":"cap.vision-screenshot","name":"截图和视觉分析","intents":["分析截图","看图","截图里有什么","识别界面","OCR","读图片"],"primary":"model.doubao-vision","fallbacks":["model.gpt55"],"supportingTools":["mcp.windows-cua","script.screenshot-vision"]},{"id":"cap.browser-web","name":"浏览器网页操作","intents":["打开网页","浏览器","网页","URL","DOM","表单","登录网页","点击网页"],"primary":"mcp.playwright","fallbacks":["mcp.windows-cua"],"requiredSkills":[]},{"id":"cap.desktop-gui","name":"Windows桌面操作","intents":["桌面","窗口","GUI","点击按钮","输入文字","快捷键","软件操作","应用"],"primary":"mcp.windows-cua","fallbacks":["script.desktop-action"],"requiredSkills":[]},{"id":"cap.deep-reasoning","name":"深度推理/复杂分析","intents":["复杂","深度","推理","架构设计","安全审计","性能分析",